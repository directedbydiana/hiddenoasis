# Gate for /admin (editing contacts). Both are required; admin is disabled otherwise.
ADMIN_PASSWORD=change-me
# At least 16 random characters. Signs the admin session cookie.
AUTH_SECRET=

# Storage. Defaults to Netlify Blobs when running on Netlify, otherwise .data/contacts.json.
# Uncomment to force one: blobs | file
# CONTACTS_STORE=file

# Optional: use the production Netlify Blobs store from `next dev` on your machine.
# NETLIFY_SITE_ID=
# NETLIFY_BLOBS_TOKEN=
